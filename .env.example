# Public site URL used for metadata, sitemap and newsletter links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Keep local development on the filesystem. Set this to vercel-blob on Vercel.
STORAGE_DRIVER=filesystem
BLOB_READ_WRITE_TOKEN=

# Admin authentication. Generate the password hash with: npm run hash-admin-password
# When placing the hash in a dotenv file, escape each $ separator as \$.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Optional email delivery for newsletter confirmation + new-post notifications.
# The site works without these; delivery is skipped until configured.
RESEND_API_KEY=
NEWSLETTER_FROM="Saifullah Suleman <updates@example.com>"
